// Diagrama de clases MediHome - fuente Graphviz (dot -Tpng MediHome_clases.dot -o MediHome_clases.png)
digraph MediHome {
  graph [rankdir=TB, splines=ortho, nodesep=0.9, ranksep=0.9, fontname="Arial", label="MediHome - Diagrama de Clases", labelloc=t, fontsize=18];
  node [shape=plaintext, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];
  INotificable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#7ecef4"><TR><TD><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>INotificable</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+notificar(mensaje: String): void</TD></TR></TABLE></TD></TR></TABLE>>];
  Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#7ecef4"><TR><TD><B>Usuario</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-identificacion: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-nombre: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-correo: String</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Usuario()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getIdentificacion(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setIdentificacion(identificacion: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getNombre(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setNombre(nombre: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getCorreo(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setCorreo(correo: String): void</TD></TR></TABLE></TD></TR></TABLE>>];
  ProfesionalSalud [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#7ecef4"><TR><TD><B>ProfesionalSalud</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-numeroRegistroProfesional: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-especialidad: String</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ProfesionalSalud()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getNumeroRegistroProfesional(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setNumeroRegistroProfesional(numeroRegistroProfesional: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getEspecialidad(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setEspecialidad(especialidad: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+notificar(mensaje: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+estaDisponible(fecha: LocalDateTime): boolean</TD></TR></TABLE></TD></TR></TABLE>>];
  Paciente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#7ecef4"><TR><TD><B>Paciente</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-telefono: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-direccion: String</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Paciente()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getTelefono(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setTelefono(telefono: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getDireccion(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setDireccion(direccion: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+notificar(mensaje: String): void</TD></TR></TABLE></TD></TR></TABLE>>];
  EquipoAtencion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#7ecef4"><TR><TD><B>EquipoAtencion</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-codigo: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-nombre: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-zonaCobertura: String</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getCodigo(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setCodigo(codigo: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getNombre(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setNombre(nombre: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getZonaCobertura(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setZonaCobertura(zonaCobertura: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agregarProfesional(profesional: ProfesionalSalud): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+retirarProfesional(profesional: ProfesionalSalud): void</TD></TR></TABLE></TD></TR></TABLE>>];
  ServicioDomiciliario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#7ecef4"><TR><TD><B>ServicioDomiciliario</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-codigo: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fechaProgramada: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-direccionAtencion: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-motivo: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-estado: String</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getCodigo(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setCodigo(codigo: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getFechaProgramada(): LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setFechaProgramada(fechaProgramada: LocalDateTime): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getDireccionAtencion(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setDireccionAtencion(direccionAtencion: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getMotivo(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setMotivo(motivo: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getEstado(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setEstado(estado: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+programar(fecha: LocalDateTime): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+asignarProfesional(profesional: ProfesionalSalud): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+iniciarAtencion(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+finalizar(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cancelar(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  AtencionMedica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#7ecef4"><TR><TD><B>AtencionMedica</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fechaHoraInicio: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fechaHoraFin: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-observaciones: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-recomendaciones: String</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getFechaHoraInicio(): LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setFechaHoraInicio(fechaHoraInicio: LocalDateTime): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getFechaHoraFin(): LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setFechaHoraFin(fechaHoraFin: LocalDateTime): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getObservaciones(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setObservaciones(observaciones: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getRecomendaciones(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setRecomendaciones(recomendaciones: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agregarMedicion(medicion: MedicionSignosVitales): void</TD></TR></TABLE></TD></TR></TABLE>>];
  MedicionSignosVitales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#7ecef4"><TR><TD><B>MedicionSignosVitales</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fechaHora: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-temperatura: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-frecuenciaCardiaca: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-presionSistolica: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-presionDiastolica: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-saturacionOxigeno: double</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getFechaHora(): LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setFechaHora(fechaHora: LocalDateTime): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getTemperatura(): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setTemperatura(temperatura: double): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getFrecuenciaCardiaca(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setFrecuenciaCardiaca(frecuenciaCardiaca: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPresionSistolica(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setPresionSistolica(presionSistolica: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getPresionDiastolica(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setPresionDiastolica(presionDiastolica: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getSaturacionOxigeno(): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setSaturacionOxigeno(saturacionOxigeno: double): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+realizarMedicion(): void</TD></TR></TABLE></TD></TR></TABLE>>];

  { rank=same; Usuario; INotificable; }
  { rank=same; EquipoAtencion; ProfesionalSalud; Paciente; }
  EquipoAtencion -> ProfesionalSalud -> Paciente [style=invis, weight=10];
  Usuario -> INotificable [style=invis];
  // Herencia
  Usuario -> ProfesionalSalud [dir=back, arrowtail=empty];
  Usuario -> Paciente [dir=back, arrowtail=empty];
  // Realización de la interfaz
  INotificable -> ProfesionalSalud [dir=back, arrowtail=empty, style=dashed];
  INotificable -> Paciente [dir=back, arrowtail=empty, style=dashed];
  // Agregación: un equipo agrupa varios profesionales
  EquipoAtencion -> ProfesionalSalud [dir=both, arrowtail=odiamond, arrowhead=none, xlabel="agrupa", taillabel="0..1", headlabel="0..*"];
  // Asociaciones
  ProfesionalSalud -> ServicioDomiciliario [arrowhead=none, xlabel="atiende", taillabel="0..1", headlabel="0..*"];
  Paciente -> ServicioDomiciliario [arrowhead=none, xlabel="solicita", taillabel="1", headlabel="0..*"];
  // Composiciones
  ServicioDomiciliario -> AtencionMedica [dir=both, arrowtail=diamond, arrowhead=none, xlabel="genera", taillabel="1", headlabel="0..1"];
  AtencionMedica -> MedicionSignosVitales [dir=both, arrowtail=diamond, arrowhead=none, xlabel="contiene", taillabel="1", headlabel="0..*"];
}
